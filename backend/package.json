{
  "name": "ishaq-medical-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "tsx src/database/seed.ts",
    "migration:up": "npx migrate-mongo up -f migrate-mongo-config.cjs",
    "migration:down": "npx migrate-mongo down -f migrate-mongo-config.cjs",
    "migration:status": "npx migrate-mongo status -f migrate-mongo-config.cjs",
    "migration:create": "npx migrate-mongo create -f migrate-mongo-config.cjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "http-status": "^2.1.0",
    "joi": "^18.2.5",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.5.0",
    "mongoose": "^9.9.4",
    "morgan": "^1.12.0",
    "multer": "^2.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/http-status": "^0.2.30",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "migrate-mongo": "^14.0.7",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2"
  }
}
